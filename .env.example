# Optional Gemini structured dialogue. Keep the real key only in .env or the host secret store.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=12000

# Optional Supabase persistence. The service role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A server-owned Supabase auth.users UUID for this local feasibility demo.
# The browser-supplied userId is never trusted for database access.
ECHOLOOM_DEMO_USER_ID=

# Optional Cloudflare Workers AI scene generation.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_TIMEOUT_MS=20000

# Runtime cache stays outside browser-delivered assets and is ignored by Git.
ECHOLOOM_SCENE_CACHE_DIR=.cache/echoloom-scenes
